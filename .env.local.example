# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by server-side scripts (USDA ingestion, edge functions) -- NEVER
# expose this to the frontend or prefix it with VITE_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# USDA FoodData Central API key (https://api.data.gov/signup)
USDA_API_KEY=your-usda-api-key

# Anthropic API key, used only inside the Supabase Edge Function for photo
# analysis -- set this as a Supabase secret, not read from the frontend.
ANTHROPIC_API_KEY=your-anthropic-api-key
