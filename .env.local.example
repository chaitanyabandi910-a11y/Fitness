# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by server-side scripts (USDA ingestion) -- NEVER expose this to
# the frontend or prefix it with VITE_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# USDA FoodData Central API key (https://api.data.gov/signup) -- the US
# government food database. Not api.data.gov.in (India's open data portal);
# that's a different system with no equivalent food-nutrition API.
USDA_API_KEY=your-usda-api-key

# --- Photo-analysis vision model (used only inside the Edge Function) -----
# Swappable at any time -- just change these three values, no code change.
# Default: Google Gemini's free tier via its OpenAI-compatible endpoint
# (generous free quota, no card required: https://aistudio.google.com/apikey).
# Set these as `supabase secrets set ...`, not read from the frontend.
VISION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VISION_API_KEY=your-gemini-api-key
VISION_MODEL=gemini-2.5-flash
