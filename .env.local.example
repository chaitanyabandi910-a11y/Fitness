# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by server-side scripts (USDA ingestion) -- NEVER expose this to
# the frontend or prefix it with VITE_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# USDA FoodData Central API key (https://api.data.gov/signup) -- the US
# government food database. Not api.data.gov.in (India's open data portal);
# that's a different system with no equivalent food-nutrition API.
USDA_API_KEY=your-usda-api-key

# --- Photo-analysis vision model (used only inside the Edge Function) -----
# Swappable at any time -- just change these three values, no code change.
# Default: OpenRouter + a free, open-weight vision model (Qwen2.5-VL).
# Set these as `supabase secrets set ...`, not read from the frontend.
VISION_API_BASE_URL=https://openrouter.ai/api/v1
VISION_API_KEY=your-openrouter-api-key
VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
